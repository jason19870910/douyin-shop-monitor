{
  "name": "douyin-monitor-docs",
  "version": "1.0.0",
  "description": "抖音电商数据监控平台 - 项目文档中心",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev .",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview .",
    "validate:frontmatter": "python3 scripts/validate_frontmatter.py",
    "generate:index": "python3 scripts/generate_index.py",
    "check:links": "python3 scripts/check_links.py",
    "lint": "markdownlint-cli2 \"**/*.md\" --config .markdownlint.json",
    "spellcheck": "cspell \"**/*.md\" --config cspell.json"
  },
  "keywords": [
    "documentation",
    "vitepress",
    "douyin",
    "monitor",
    "project-docs"
  ],
  "author": "抖音电商数据监控平台项目组",
  "license": "MIT",
  "devDependencies": {
    "vitepress": "^1.0.0",
    "vue": "^3.4.0",
    "markdownlint-cli2": "^0.12.0",
    "cspell": "^8.0.0",
    "mermaid": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
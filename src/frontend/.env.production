# Frontend Production Environment Variables
# =============================================================================
# API Base URL (without /api/v1 suffix - it's added by axios baseURL in apiClient.ts)
# Production: use relative URL so nginx in frontend container proxies to monitor:5000
# Leave empty for relative URLs (recommended for containerized deployment)
VITE_API_URL=

# API Key for Authorization header
VITE_API_KEY=wlkj_douyin_api_20260921_abc123

# Production mode
VITE_DEV_MODE=false

# Mock Fallback (for 503/401 error handling)
# 生产环境必须关闭 mock 兜底，否则前端将始终显示模拟数据而不调用真实 API
VITE_ENABLE_MOCK_FALLBACK=false
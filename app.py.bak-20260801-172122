def fetch_product_list(page=1, page_size=20):
    """
    商品列表 API 抓取(需要 PRODUCTS_URL)
    - 若配置 PRODUCTS_URL,则抓取真实数据
    - 否则返回模拟数据(基于商品统计总数,确保非空)
    """
    try:
        if isinstance(page, str):
            page = int(page)
        if isinstance(page_size, str):
            page_size = int(page_size)
        if not PRODUCTS_URL or not PRODUCTS_URL.startswith(('http://', 'https://')):
            logger.warning("PRODUCTS_URL 未配置或格式不正确,返回 None")
            return None
        params = {
            'page': page - 1,
            'pageSize': page_size,
            'business_type': 4,
            'is_online': 1,
            'from_mng': 1,
            'need_auto_rectify_info': 'true',
            'need_pay_no_stock_skus': 'false',
            'appid': 1,
            'tab': 'all',
            'check_status': '',
            'group_id': '',
            'sku_type': '',
            'supply_status': '',
            'need_price': 'true',
            'need_stock': 'true',
        }
        headers = build_product_headers(PRODUCTS_URL)
        logger.info(f"商品列表 API 抓取: page={params['page']}, pageSize={page_size}")
        resp = requests.get(PRODUCTS_URL, headers=headers, params=params, timeout=15)
        resp.raise_for_status()
        data = resp.json()
        items = data.get('data') or data.get('list') or data.get('items') or data.get('records') or []
        if not items:
            logger.warning("商品列表数据为空")
            return { "products": [], "total": 0 }
        products = []
        for item in items:
            if not products: logger.info(f"First item keys: {list(item.keys())}")
            if not products: logger.info(f"First item raw: {item}")
            prod_id = str(item.get('id') or item.get('product_id') or item.get('item_id') or '')
            name = item.get('name') or item.get('title') or '未命名'
            price_raw = item.get('price') or item.get('sale_price') or item.get('amount') or item.get('price_lower') or item.get('market_price') or 0
            price = float(price_raw) if price_raw else 0.0
            stock = int(item.get('stock') or item.get('inventory') or item.get('total_stock') or item.get('available_stock') or item.get('stock_num') or item.get('self_sell_stock_num') or 0)
            status_raw = item.get('status') or item.get('sale_status') or item.get('online_status') or ''
            status = 1 if status_raw in [1, '1', 'on_sale', 'ON_SALE', '售卖中', '上架'] else 0
            image = item.get('image') or item.get('cover') or item.get('img') or item.get('image_url') or ''
            updated_at = item.get('updated_at') or item.get('updatedAt') or item.get('modify_time') or item.get('create_time') or datetime.now().isoformat()
            products.append({
                'id': prod_id,
                'name': name,
                'price': price,
                'stock': stock,
                'status': status,
                'image': image,
                'updatedAt': updated_at
            })
        total = data.get('total') or data.get('count') or data.get('total_count') or len(items)
        total = int(total)
        logger.info(f"商品列表 API 抓取完成: {len(products)}/{total}")
        return { "products": products, "total": total }
    except Exception as e:
        logger.error(f"商品列表 API 抓取失败: {e}")
        return None


@app.route('/api/products', methods=['GET'])
def get_products():
    """商品列表(分页:page, limit)
    - 若配置 PRODUCTS_URL,则抓取真实数据
    - 否则返回模拟数据(基于商品统计总数,确保非空)
    """
    page = int(request.args.get('page', 1))
    limit = int(request.args.get('limit', 20))
    result = fetch_product_list(page, limit)
    if result is None:
        # 生成模拟数据:商品总数 = fetch_product_metrics() 中的「全部」,若失败则默认 16
        try:
            stats = fetch_product_metrics()
            total_count = stats.get('全部', 0) if stats else 0
        except:
            total_count = 0
        if total_count == 0:
            total_count = 16
        start = (page - 1) * limit
        end = min(start + limit, total_count)
        mock_products = [
            {
                'id': str(1000 + i),
                'name': f'商品 {i}',
                'price': 99.9,
                'stock': 100,
                'status': 1,
                'image': '/static/placeholder-product.png',
                'updatedAt': datetime.now().isoformat()
            }
            for i in range(start + 1, end + 1)
        ]
        return jsonify({
            "success": True,
            "data": mock_products,
            "page": page,
            "page_size": limit,
            "total": total_count
        })
    return jsonify({
        "success": True,
        "data": result['products'],
        "page": page,
        "page_size": limit,
        "total": result['total']
    })


def save_to_history(data):
    os.makedirs(DATA_DIR, exist_ok=True)
    history = []
    if os.path.exists(HISTORY_FILE):
        with open(HISTORY_FILE, 'r', encoding='utf-8') as f:
            try:
                history = json.load(f)
            except:
                history = []
    history.append(data)
    if len(history) > 100:
        history = history[-100:]
    with open(HISTORY_FILE, 'w', encoding='utf-8') as f:
        json.dump(history, f, ensure_ascii=False, indent=2)

def send_alert_email(subject, body, is_html=False):
    if not EMAIL_TO or not EMAIL_PASSWORD:
        logger.warning("邮件配置不完整,跳过发送")
        return
    try:
        msg = MIMEText(body, 'html' if is_html else 'plain', 'utf-8')
        msg['Subject'] = subject
        msg['From'] = EMAIL_FROM
        msg['To'] = ', '.join(EMAIL_TO)
        with smtplib.SMTP(SMTP_SERVER, SMTP_PORT) as server:
            server.starttls()
            server.login(EMAIL_FROM, EMAIL_PASSWORD)
            server.send_message(msg)
        logger.info("邮件发送成功")
    except Exception as e:
        logger.error(f"邮件发送失败: {e}")

def generate_html_report(data):
    html = f"""
<h2>抖音店铺数据报告 ({data['timestamp']})</h2>
<h3>运营指标</h3>
<table border="1" cellpadding="8" style="border-collapse: collapse;">
    <tr><th>指标</th><th>数值</th></tr>
"""
    for k, v in data['运营指标'].items():
        color = "red" if k in ALERT_THRESHOLDS and int(v) > ALERT_THRESHOLDS[k] else ""
        html += f'<tr><td>{k}</td><td style="color:{color}">{v}</td></tr>'
    html += """
</table>
<h3>商品管理</h3>
<table border="1" cellpadding="8" style="border-collapse: collapse;">
    <tr><th>指标</th><th>数值</th></tr>
"""
    for k, v in data['商品管理'].items():
        html += f'<tr><td>{k}</td><td>{v}</td></tr>'
    html += "</table>"
    return html

def check_alert(data):
    alerts = []
    for category in ["运营指标", "商品管理"]:
        for k, v in data[category].items():
            if k in ALERT_THRESHOLDS and int(v) > ALERT_THRESHOLDS[k]:
                alerts.append(f"{k}: {v} (阈值 {ALERT_THRESHOLDS[k]})")
    return alerts

def scheduled_job():
    logger.info("开始定时抓取...")
    data = fetch_all_metrics()
    if data is None:
        logger.error("抓取失败,跳过本次任务")
        return
    save_to_history(data)
    alerts = check_alert(data)
    html_report = generate_html_report(data)
    subject = f"抖音店铺数据报告 {data['timestamp']}"
    if alerts:
        subject = f"[告警] {subject}"
        html_report = f"<h3 style='color:red;'>⚠️ 以下指标超过阈值:</h3><ul>" +                       "".join([f"<li>{a}</li>" for a in alerts]) +                       "</ul>" + html_report
    send_alert_email(subject, html_report, is_html=True)
    logger.info("定时任务完成")


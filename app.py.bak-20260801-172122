        scheduler.add_job(scheduled_job, 'cron', hour=hour, minute=0)
    scheduler.start()
    logger.info(f"定时任务已启动，每天 {SCHEDULE_HOURS} 点执行")
    scheduled_job()


@app.route('/admin/reload-env', methods=['POST'])
def admin_reload_env():
    # 用 globals() 读取当前 API_KEY，避免局部变量遮蔽
    current_api_key = globals().get('API_KEY', '')
    if current_api_key and request.headers.get('X-API-KEY') != current_api_key:
        return jsonify({'error': 'Unauthorized'}), 401
    try:
        # 1. 刷新 os.environ
        load_dotenv(override=True)
        # 2. 刷新 config 模块的全局变量，并同步到本模块
        from config import reload as config_reload
        new_cfg = config_reload()
        g = globals()
        for name, val in new_cfg.items():
            g[name] = val
        logger.info('热重载完成，配置已刷新')
        return jsonify({'status': 'reloaded', 'ts': datetime.now().isoformat()})
    except Exception as e:
        logger.error(f"热重载失败: {e}")
        return jsonify({'status': 'error', 'message': str(e)}), 500



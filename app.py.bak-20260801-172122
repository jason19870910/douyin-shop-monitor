def handle_exception(exc_type, exc_value, exc_traceback):
    if issubclass(exc_type, KeyboardInterrupt):
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return
    logger.error('Uncaught exception', exc_info=(exc_type, exc_value, exc_traceback))
sys.excepthook = handle_exception

logger = logging.getLogger(__name__)

def parse_cookie(cookie_value):
    """
    解析 Cookie 值。
    支持:原始字符串 或 Cookie 文件路径
    """
    if not cookie_value:
        return ""
    if os.path.exists(cookie_value):
        try:
            with open(cookie_value, 'r', encoding='utf-8') as f:
                content = f.read().strip()
            if '\t' in content:
                cookies = []
                for line in content.splitlines():
                    if line.startswith('#') or not line.strip():
                        continue
                    parts = line.strip().split('\t')
                    if len(parts) >= 7:
                        name = parts[5]
                        value = parts[6]
                        cookies.append(f"{name}={value}")
                return '; '.join(cookies)
            return content.strip()
        except Exception as e:
            logger.error(f"Cookie 解析失败: {e}")
            return cookie_value
    return cookie_value.strip()

def extract_csrf_token(url):
    """从 URL 中提取 __token 参数"""
    try:
        parsed = urlparse(url)
        params = parse_qs(parsed.query)
        token_list = params.get('__token', [])
        return token_list[0] if token_list else ''
    except Exception as e:
        logger.warning(f"URL 解析失败: {e}")
        return ''


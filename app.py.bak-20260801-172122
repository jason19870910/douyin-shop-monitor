def fetch_creator_metrics():
    """使用抖音创作者中心 API 抓取数据。
    POST /janus/douyin/creator/data/overview/dashboard  Body: {recent_days: 1}
    失败则返回 None(由调用方降级为模拟数据)。
    """
    try:
        url = CREATOR_URL
        headers = {
            'User-Agent': 'Mozilla/5.0',
            'Cookie': CREATOR_COOKIE,
            'Content-Type': 'application/json',
            'X-CSRF-Token': CREATOR_CSRF_TOKEN,
            'X-Secsdk-Csrf-Token': CREATOR_CSRF_TOKEN,
            'Origin': 'https://creator.douyin.com',
            'Referer': 'https://creator.douyin.com/janus/douyin/creator/data/overview/dashboard',
        }
        resp = requests.post(url, headers=headers, json={'recent_days': 1}, timeout=10)
        resp.raise_for_status()
        j = resp.json()

        if j.get('status_code') != 0 or 'metrics' not in j:
            logger.error(f"创作者中心接口返回异常: {j.get('status_msg')}")
            return None

        # 将 metrics 数组映射为前端所需的中文键
        mapping = {
            'play_cnt': '视频播放量',
            'digg_cnt': '点赞量',
            'share_count': '分享数',
            'comment_cnt': '评论数',
            'net_fans_cnt': '净增粉丝',
            'cancel_fans_cnt': '取消关注',
            'homepage_view_cnt': '主页浏览量',
            'cover_click_ratio': '封面点击率',
            'total_fans_cnt': '粉丝总数',
        }

        result = {}
        for item in j['metrics']:
            eng = item.get('english_metric_name')
            val = item.get('metric_value')
            if eng in mapping:
                cn_key = mapping[eng]
                # 保持原样(含空值、负值都是真实数据)
                result[cn_key] = val if val is not None else 0

        # 确保必填字段存在
        for k in mapping.values():
            if k not in result:
                result[k] = 0

        logger.info(f"创作者数据抓取成功: {result}")
        return result

    except Exception as e:
        logger.error(f"抓取创作者中心失败: {e}")
        return None


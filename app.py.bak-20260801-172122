def fetch_homepage_metrics():
    try:
        resp = requests.get(HOMEPAGE_URL, headers=build_product_headers(HOMEPAGE_URL), timeout=10)
        resp.raise_for_status()
        data = resp.json()
        # 兼容性:先尝试原结构,再降级处理
        try:
            todo_list = data["data"]["lay_out_data"][1]["cards"][0]["data"]["todo_list_card_data"]["todo_list"]
            return {item["title"]: str(item["val"]) for item in todo_list}
        except (KeyError, IndexError, TypeError):
            # 如果结构不同,尝试从 data 中提取第一个字典作为指标
            if isinstance(data, dict) and data:
                # 取除了常见元字段外的第一个数值字段
                for v in data.values():
                    if isinstance(v, dict):
                        return {str(k): str(v2) for k, v2 in v.items() if isinstance(v2, (int, float, str))}
            return None
    except Exception as e:
        logger.error(f"抓取运营指标失败: {e}")
        return None

def fetch_product_metrics():
    try:
        resp = requests.get(PRODUCT_URL, headers=build_product_headers(PRODUCT_URL), timeout=10)
        resp.raise_for_status()
        data = resp.json()
        # 兼容不同响应结构
        p = data.get("data") or data.get("result") or data.get("aggregate") or data.get("stats") or data
        if isinstance(p, dict):
            # 映射常见字段名变体
            onsale = p.get("onsale") or p.get("on_sale") or p.get("selling") or p.get("online") or 0
            sell_out = p.get("sell_out_new") or p.get("sold_out") or p.get("soldout") or 0
            draft = p.get("draft") or p.get("offline") or p.get("unpublished") or 0
            forbidden = p.get("forbidden") or p.get("banned") or 0
            audit = p.get("audit") or p.get("reviewing") or 0
            unpass = p.get("unpass") or p.get("rejected") or 0
            total = sum([int(onsale), int(sell_out), int(draft), int(forbidden), int(audit), int(unpass)])
            return {
                "全部": total,
                "售卖中": int(onsale),
                "已售罄": int(sell_out),
                "已下架": int(draft),
                "已封禁": int(forbidden),
                "审核中": int(audit),
                "审核驳回": int(unpass),
                "审核通过商品": int(onsale) + int(sell_out)
            }
        else:
            logger.warning("商品指标响应格式非字典")
            return None
    except Exception as e:
        logger.error(f"抓取商品指标失败: {e}")
        return None


# docker-compose.yml 插值变量（复制为项目根 .env 后按需填写；.env 已被 gitignore）
# 告警通知邮箱（通用告警配置的默认收件人）
ALERT_EMAIL=
# API 鉴权 token（后端 X-API-Token 校验）
API_AUTH_TOKEN=
# 前端构建期内联的 API Key（缺省见 vite.config.ts 默认值）
VITE_API_KEY=wlkj_douyin_api_20260921_abc123
# 最近一次部署时间（ISO8601，由 scripts/deploy.sh 或 CI 部署步骤自动写入，请勿手填）
LAST_DEPLOY_TIME=

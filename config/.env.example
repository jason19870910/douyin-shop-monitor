# 环境变量示例文件 - 最后更新时间: 2026-10-27
# 复制此文件为 .env 并填入真实值
# ⚠️ 切勿提交真实 .env 到 Git（已在 .gitignore 中屏蔽）
# =============================================================================

# =============================================================================
# 基础配置
# =============================================================================
# 数据存储目录（容器内映射为 /data）
DATA_DIR=./data

# 定时任务间隔（分钟）
SCHEDULE_INTERVAL_MINUTES=60

# 跨域允许的来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 告警通知邮箱
ALERT_EMAIL=alert@example.com

# API 认证 Token（用于内部服务间调用）
API_AUTH_TOKEN=your_api_auth_token

# API 密钥（可选，用于 API 认证）
API_KEY=your_api_key

# 跳过鉴权开关（调试用，true/false）
SKIP_AUTH=false

# 通用 Cookie（可选，用于某些请求）
COOKIE=

# 请求超时配置（秒）
KEEP_ALIVE_TIMEOUT=30
TIMEOUT=30

# 外部数据服务基础 URL（可选，预留扩展）
EXTERNAL_DATA_BASE_URL=https://example.com/monitor

# =============================================================================
# 抖音开放平台配置（OAuth 2.0）
# =============================================================================
DOUYIN_APP_ID=your_app_id
DOUYIN_APP_SECRET=your_app_secret
DOUYIN_ACCESS_TOKEN=your_access_token
OAUTH_REDIRECT_URI=https://wlkj-tech.cn/api/v1/auth/callback
DOUYIN_SCOPE=user_info
DOUYIN_SCOPE=user_info

# =============================================================================
# 双域名基础 URL（抖店/创作者中心）
# =============================================================================
FXG_BASE_URL=https://fxg.jinritemai.com
CREATOR_BASE_URL=https://creator.douyin.com

# =============================================================================
# 公共请求头配置
# =============================================================================
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36

# =============================================================================
# 认证与签名参数（强时效性，需定期手动更新，通常 2h-7 天失效）
# 获取方式：浏览器登录目标网站 -> F12 Network -> 任意请求 -> Request Headers
# 注意：__TOKEN / TOKEN 为非必需参数，订单数据主要依赖 FXG_COOKIES 会话 Cookie
# 清空 TOKEN 后 /api/v1/orders 仍可正常返回真实订单数据
# =============================================================================
# 抖店签名参数
__TOKEN=your_token
MS_TOKEN=your_ms_token
a_bogus=your_a_bogus
verifyFp=your_verifyFp
fp=your_fp

# 抖店 Shop ID 与 Log ID（多店铺场景需配置）
FXG_SHOP_ID=4272
FXG_LOG_ID=104476165896

# =============================================================================
# Cookie 配置（完整 Cookie 字符串，分号分隔）
# 获取方法：浏览器登录 -> F12 -> Network -> 任意请求 -> Request Headers -> Cookie
# =============================================================================
# 抖店 Cookie (fxg.jinritemai.com)
# 必含字段示例：passport_csrf_token、sessionid、ttwid、s_v_web_id 等
FXG_COOKIES=your_fxg_cookies

# 创作者中心 Cookie (creator.douyin.com)
# 必含字段示例：passport_csrf_token、ttwid、bd_ticket_guard_client_data 等
CREATOR_COOKIES=your_creator_cookies

# =============================================================================
# 新增外部 API 专用 Cookie（系统级接口，未配置时接口返回空数据）
# 获取方法：浏览器登录对应域名 -> F12 Network -> 任意请求 -> Request Headers -> Cookie
# =============================================================================
# 指南针（抖店经营数据）Cookie (compass.jinritemai.com)
COMPASS_COOKIES=your_compass_cookies

# 好货平台 Cookie (haohuo.jinritemai.com)
HAOHUO_COOKIES=your_haohuo_cookies

# =============================================================================
# 创作者中心 x-secsdk-csrf-token（POST请求必需，从浏览器Network获取，约2h-7天失效）
# 获取方法：浏览器登录 creator.douyin.com -> F12 Network -> 任意POST请求 -> Headers -> x-secsdk-csrf-token
# =============================================================================
CREATOR_CSRF_TOKEN=your_creator_csrf_token

# =============================================================================
# Celery / Redis 配置（仅 docker-compose.yml 使用，Python 代码不直接读取）
# =============================================================================
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# 说明：以下 API 端点在代码中通过基础 URL 拼接生成，无需单独配置
# 仅作参考，实际请求路径见 app.py / tasks.py
# =============================================================================
# PRODUCT_LIST_URL=${FXG_BASE_URL}/product/tproduct/list
# PRODUCT_STATS_URL=${FXG_BASE_URL}/product/tproduct/aggsProductCount
# ORDER_SEARCH_URL=${FXG_BASE_URL}/api/order/searchlist
# ORDER_STATS_URL=${FXG_BASE_URL}/api/order/tabcnt
# CREATOR_DASHBOARD_URL=${CREATOR_BASE_URL}/janus/douyin/creator/data/overview/dashboard

# =============================================================================
# 注意：COMMON_HEADERS 为 config.py 计算属性（含 USER_AGENT），非环境变量
# =============================================================================